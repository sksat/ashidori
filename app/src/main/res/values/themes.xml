<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ashidori brand: deep teal ("足取り" = where one's steps went) as primary, a warm
         orange secondary and a purple tertiary (check-ins) so the UI is not all
         one hue; neutral surfaces. Material 3 roles, light scheme. -->
    <style name="Theme.Ashidori" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#006A60</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#9DF2E3</item>
        <item name="colorOnPrimaryContainer">#00201C</item>
        <item name="colorSecondary">#9A4600</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#FFDBC8</item>
        <item name="colorOnSecondaryContainer">#321300</item>
        <item name="colorTertiary">#7A40C8</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#EEDCFF</item>
        <item name="colorOnTertiaryContainer">#2A0054</item>
        <item name="colorError">#BA1A1A</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">#FFDAD6</item>
        <item name="colorOnErrorContainer">#410002</item>
        <item name="android:colorBackground">#F8F9FB</item>
        <item name="colorOnBackground">#191C1E</item>
        <item name="colorSurface">#F8F9FB</item>
        <item name="colorOnSurface">#191C1E</item>
        <item name="colorSurfaceVariant">#DFE3E8</item>
        <item name="colorOnSurfaceVariant">#42474D</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#F2F4F7</item>
        <item name="colorSurfaceContainer">#ECEEF2</item>
        <item name="colorSurfaceContainerHigh">#E6E8EC</item>
        <item name="colorSurfaceContainerHighest">#E0E2E6</item>
        <item name="colorOutline">#72777E</item>
        <item name="colorOutlineVariant">#C2C7CE</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
