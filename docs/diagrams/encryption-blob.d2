# blob の形式（docs/encryption.md）
direction: right

plain: "平文\nJSON Lines を gzip で圧縮"
nonce: "nonce\n乱数 12 byte"
key: バッチ鍵
aad: "AAD（blob には含めない）\n{deviceId}/{stream}/{seq}" {style.stroke-dash: 4}
gcm: AES-256-GCM

blob: blob（先頭から順に） {
  shape: sql_table
  識別子 ASH1: 4 byte
  nonce: 12 byte
  暗号文: 可変長
  認証タグ: 16 byte
}

plain -> gcm
nonce -> gcm
key -> gcm
aad -> gcm
nonce -> blob.nonce
gcm -> blob.暗号文
gcm -> blob.認証タグ
