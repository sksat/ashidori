# 端末の外とのやり取り（README）
# 破線は「データの扱い」で送信先ごとに許可したときだけの経路を表す。
direction: down

classes: {
  gated: {style.stroke-dash: 4}
}

releases: "GitHub Releases\nオフライン地図・施設データ\n地域データ（選んだ区画）"

phone: 端末 {
  grid-columns: 2
  grid-gap: 40
  pin: "固定した sha256\nで照合"
  local: "端末内の地図・地名・施設\n通信せずに表示・検索"
  pin -> local
}

ext: "外部サービス（「データの扱い」で許可した分だけ）" {
  grid-columns: 3
  grid-gap: 24
  tiles: "オンライン地図\n表示範囲"
  geocoder: "Android の\nGeocoder\n位置"
  overpass: "OpenStreetMap の\n施設検索\n位置"
}

sync: "同期サーバ"

releases -> phone: 取得
phone -> ext {class: gated}
phone -> sync: 暗号文
