# データフロー（README）
# 端末は記録を暗号化したバッチにして送り、同期サーバは暗号化したバッチと
# その一覧だけを持つ。復号できるのは利用者の端末とペアリングしたブラウザだけ。
direction: down

*.style.font-size: 26
*.*.style.font-size: 26
*.*.*.style.font-size: 26
(** -> **)[*].style.font-size: 22
(** <-> **)[*].style.font-size: 22

# Every arrow points the way the data moves: written on the device, or sent
# encrypted over the network.
classes: {
  local: {style: {stroke: "#5b5a56"; stroke-width: 3}}
  encrypted: {style: {stroke: "#2a78d6"; stroke-width: 3}}
}

phone: 端末 {
  sensors: "センサー\nGNSS・IMU・気圧・電池"

  sqlite: SQLite {
    today: 当日のセンサーの記録 {shape: cylinder}
    edits: "場所・チェックイン\n移動手段の修正" {shape: cylinder}
  }

  parquet: Parquet {
    files: 日・月のファイル {shape: cylinder}
  }

  sensors -> sqlite.today: 記録 {class: local}
  sqlite.today -> parquet.files: 翌日以降に移す {class: local}
}

cf: 同期サーバ（Cloudflare） {
  label.near: top-left
  worker: Worker

  r2: Cloudflare R2 {
    batches: 暗号化したバッチ {shape: cylinder}
  }

  d1: Cloudflare D1 {
    index: "バッチの一覧\n端末・種類・大きさ・時刻" {shape: cylinder}
    accounts: "利用者・端末" {shape: cylinder}
  }

  worker <-> r2.batches: 保存・取り出し {class: encrypted}
  worker -> d1.index: 一覧に追加 {class: local}
}

web: "Web 版（ブラウザ）\nブラウザの中で復号"
other: "別の端末\n端末の中で復号"

phone.sqlite.edits -> cf.worker: 暗号化して送る {class: encrypted}
phone.parquet.files -> cf.worker: 暗号化して送る {class: encrypted}
web <- cf.worker: 暗号化したバッチ {class: encrypted}
other <- cf.worker: 暗号化したバッチ {class: encrypted}
