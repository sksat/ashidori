{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ashidori-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // Keep console.error/warn output, but not the per-request invocation logs,
  // which would keep metadata (and timing) of every request.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  // Maintenance (src/index.ts): deletes ended rate-limit counters (keyed by
  // client IP), old pairing codes, unused self-registered accounts and
  // unreferenced R2 objects, each in bounded chunks.
  "triggers": { "crons": ["*/10 * * * *"] },
  // Routing (a custom domain, needed so Cloudflare Access can protect
  // /admin/*) is configured outside this file, e.g. in the dashboard or by
  // infrastructure code, so deploys cannot change it.

  // Batch metadata, devices, pairing codes and rate-limit counters.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ashidori",
      // Replaced at deploy time with the D1_DATABASE_ID secret; local dev ignores it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Encrypted batch blobs (opaque to the server).
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "ashidori-blobs"
    }
  ],

  // The web viewer (web/, built with `pnpm --dir web build`), served at `/`
  // by src/viewer.ts. run_worker_first: every request reaches the Worker,
  // which sets the viewer's headers (CSP) and keeps the other routes as they are.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Coarse rate limits in front of the precise D1 counters (src/ratelimit.ts):
  // per Cloudflare location, 60-second windows, looser than the D1 limits.
  // RL_ACCOUNT is required when REGISTRATION is "open" (without it,
  // self-registration is refused with 503); without the others, their
  // checks pass with a warning.
  // namespace_id must be unique within the Cloudflare account; change these
  // if another Worker of the account already uses them.
  "ratelimits": [
    { "name": "RL_REGISTER", "namespace_id": "41001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_ACCOUNT", "namespace_id": "41002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_PAIRING", "namespace_id": "41003", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_LOOKUP", "namespace_id": "41004", "simple": { "limit": 20, "period": 60 } }
  ],

  "vars": {
    // Cloudflare Access team domain, e.g. "example.cloudflareaccess.com".
    "CF_ACCESS_TEAM_DOMAIN": "",
    // Application Audience (AUD) tag of the Access application that covers /admin/*.
    "CF_ACCESS_AUD": "",
    // Comma-separated list of origins allowed for CORS on /v1/* (future web viewer). Empty = no CORS.
    "CORS_ALLOWED_ORIGINS": "",
    // Only for local development: accept the ADMIN_DEV_TOKEN secret on /admin/*. Never "true" in production.
    "ALLOW_DEV_ADMIN": "false",
    // Comma-separated e-mail addresses (case-insensitive) of the admins. /admin/* requires a
    // verified Access JWT whose email is listed here. Empty = nobody (admin API disabled).
    "ADMIN_EMAILS": "",
    // Who creates users. "admin": only admins (admin page). Exactly "open": anyone may create a
    // user from the app (POST /v1/accounts). Any other value, including empty, means "admin".
    "REGISTRATION": "admin",
    // Limits (src/config.ts). Empty = the default. Any other value must be a positive integer:
    // an invalid one (e.g. "0", "10MiB") stops the creation of new users, devices and data,
    // and fails the deploy workflow.
    // Per user (the legacy devices together count as one): total blob bytes (default 2 GiB),
    "USER_QUOTA_BYTES": "",
    // number of batches (default 200000),
    "USER_MAX_BATCHES": "",
    // devices ever registered, revoked ones included (default 50),
    "USER_MAX_DEVICES": "",
    // shared check-ins, unshared ones included (default 5000).
    "USER_MAX_SHARED_CHECKINS": "",
    // Whole server: users, for self-registration (default 100),
    "MAX_USERS": "",
    // total blob bytes (default 50 GiB).
    "MAX_TOTAL_BYTES": "",
    // SHA-256 fingerprints of the app's signing certificates (comma-separated, "AB:CD:..." or
    // 64 hex digits), served in /.well-known/assetlinks.json so that registration links
    // (https://<host>/pair#c=<CODE>) open the app. Empty = "[]" (links open the /pair page).
    "ANDROID_CERT_SHA256": ""
  }

  // Secrets (not in this file):
  //   ADMIN_DEV_TOKEN  - only used when ALLOW_DEV_ADMIN == "true" (local dev). Put it in .dev.vars.
}
