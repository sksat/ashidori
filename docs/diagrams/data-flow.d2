# データフロー（README）
# 端末は記録を暗号化してから送る。復号できるのは利用者の端末とペアリングしたブラウザだけで、同期サーバには暗号化した記録だけが届く。
direction: down
grid-rows: 3
grid-gap: 100

phone: 端末 {
  grid-columns: 3
  horizontal-gap: 130
  sensors: "センサー\nGNSS・IMU・気圧・電池"
  db: "SQLite\n当日のセンサーの記録\n場所・チェックイン\n移動手段の修正" {shape: cylinder}
  archive: "Parquet\n前日までのセンサーの記録\n日・月ごとのファイル" {shape: cylinder}

  sensors -> db: 記録
  db -> archive: 移す
}

server: 同期サーバ {
  grid-columns: 2
  horizontal-gap: 150
  # The Worker on the left (under the device's encryption and above the readers),
  # the stores on the right, so no arrow crosses a store.
  api: "Worker（Cloudflare Workers）\n認証・記録の受け渡し\nWeb 版と管理ページの配信"
  stores: "" {
    style.fill: transparent
    style.stroke: transparent
    grid-rows: 2
    vertical-gap: 24
    blobs: "暗号化した記録\n（Cloudflare R2）" {shape: cylinder}
    meta: "利用者・端末・記録の一覧\n（Cloudflare D1）" {shape: cylinder}
  }
  api -> stores.blobs: 保存・取り出し
  api -> stores.meta: 更新・参照
}

readers: "" {
  style.fill: transparent
  style.stroke: transparent
  grid-columns: 2
  horizontal-gap: 80
  web: "Web 版（ブラウザ）\nブラウザの中で復号して表示"
  other: "同じ利用者の別の端末\n端末の中で復号して表示"
}

phone -> server.api: 暗号化して送る
server.api -> readers.web: 暗号化した記録を取得
server.api -> readers.other: 暗号化した記録を取得
